{
  "name": "yourmoney-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:mobile": "ng build --configuration production && cap sync android",
    "mobile:sync": "cap sync android",
    "mobile:open": "cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@angular/service-worker": "^20.3.34",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "pluggy-connect-sdk": "^2.14.2",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.22.4",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.41",
    "@angular/cli": "20.3.41",
    "@angular/compiler-cli": "20.3.34",
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.62.1",
    "@types/chart.js": "^2.9.41",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
